# Database connection string (Postgres / Neon)
# Used by: api, pusher, worker, packages/db
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis connection string (Upstash rediss:// or redis://)
# Used by: pusher, worker, packages/redis-streams
REDIS_URL=rediss://default:password@example.upstash.io:6379

# JWT secret key for auth tokens
# Used by: api
JWT_SECRET=your-super-secret-jwt-key

# Region ID for worker (must match a Region.id record in Postgres DB)
# Used by: worker
REGION_ID=us-east-1

# Unique Worker Identifier
# Used by: worker
WORKER_ID=worker-1

# Port for Express API server
# Used by: api
PORT=3000

# Base URL of the deployed Express API
# Used by: web (frontend on Vercel)
NEXT_PUBLIC_API_BASE=http://localhost:3000
